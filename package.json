{
  "name": "vizzy",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "npm run type-check --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace=@vizzy/share",
    "test:watch": "turbo run test:watch",
    "clean": "turbo run clean",
    "convex:dev": "convex dev"
  },
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "convex": "^1.27.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.10.0",
    "prettier": "^3.0.0",
    "turbo": "^2.3.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
