{
  "name": "vizzy",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "npm run type-check --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace=@vizzy/share",
    "eval": "npm test --workspace=@vizzy/eval",
    "test:watch": "turbo run test:watch",
    "clean": "turbo run clean",
    "convex:dev": "convex dev"
  },
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "convex": "^1.51.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.15.0",
    "jsdom": "31.0.1",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "overrides": {
    "jsdom": "31.0.1"
  }
}
