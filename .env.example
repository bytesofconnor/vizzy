# Share / compose
NEXT_PUBLIC_SITE_URL=http://localhost:3456

# Convex (npx convex dev from the repo root)
NEXT_PUBLIC_CONVEX_URL=
COMPOSE_SERVER_SECRET=
COMPOSE_SALT=

# Same COMPOSE_SERVER_SECRET must be set on the Convex deployment:
# npx convex env set COMPOSE_SERVER_SECRET ...
# Dashboards and where each var lives: docs/ops.md

# Stripe — create a Vizzy account. Do not charge on the Medium / MEDIUM.COM account.
# Local: sk_test. Live keys only after the statement descriptor is VIZZY.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Email (magic link to restore paid charts)
RESEND_API_KEY=
RESEND_FROM=

# Your first-checkout email. Convex only:
# npx convex env set OWNER_EMAILS you@example.com
# That wallet skips the meter. Not a public account system.
OWNER_EMAILS=

# Google (optional). After checkout, keep the paid charts on this Google account.
# Web client. Authorized JS origins: http://localhost AND http://localhost:3456, plus https://vizzy.run.
# Authorized redirect URIs: http://localhost:3456/api/save/google and https://vizzy.run/api/save/google.
# Open the app at http://localhost:3456 — not 127.0.0.1.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Playwright. Same keys as the app. Owner email must match Convex OWNER_EMAILS.
E2E_OWNER_EMAIL=
