{
  "name": "@vizzy/mcp",
  "version": "0.1.0",
  "description": "MCP server for the Vizzy chart compiler",
  "main": "dist/index.js",
  "bin": {
    "vizzy-mcp": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format cjs --dts --clean",
    "dev": "tsup src/index.ts src/cli.ts --format cjs --dts --watch",
    "start": "node dist/cli.js",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@vizzy/core": "*",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
