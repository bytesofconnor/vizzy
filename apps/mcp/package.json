{
  "name": "@vizzy/mcp",
  "version": "0.1.0",
  "description": "MCP server for Vizzy — gather rows, emit ChartConfig v1, publish a paste URL and PNG.",
  "main": "dist/index.js",
  "bin": {
    "vizzy-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bytesofconnor/vizzy.git",
    "directory": "apps/mcp"
  },
  "homepage": "https://vizzy.run/agents",
  "keywords": [
    "vizzy",
    "mcp",
    "chart",
    "chartconfig"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format cjs --dts --clean",
    "dev": "tsup src/index.ts src/cli.ts --format cjs --dts --watch",
    "start": "node dist/cli.js",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@vizzy/core": "*",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
