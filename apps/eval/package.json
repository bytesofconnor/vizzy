{
  "name": "@vizzy/eval",
  "version": "0.1.0",
  "private": true,
  "description": "Offline chart eval lab — tagged prompt grid, mechanical scoring, recs. No Convex, no Next.",
  "main": "dist/index.js",
  "bin": {
    "vizzy-eval": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format cjs --dts --clean",
    "dev": "tsup src/index.ts src/cli.ts --format cjs --dts --watch",
    "start": "node dist/cli.js",
    "lint": "eslint \"src/**/*.ts\" --ignore-pattern \"**/*.test.ts\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "node dist/cli.js",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bytesofconnor/vizzy.git",
    "directory": "apps/eval"
  },
  "dependencies": {
    "@vizzy/core": "*",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
