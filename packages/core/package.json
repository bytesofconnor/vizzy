{
  "name": "@vizzy/core",
  "version": "0.1.0",
  "description": "Chart compiler runtime — ChartConfig in, SVG out",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./schema/chart-config.v1.json": "./src/schema/chart-config.v1.json"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "jsdom": "^30.1.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
