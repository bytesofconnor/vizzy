{
  "name": "@vizzy/resolve",
  "version": "0.1.0",
  "description": "Resolve a chart prompt to an official public series — match, fetch, normalize",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint \"src/**/*.ts\" --ignore-pattern \"**/*.test.ts\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
